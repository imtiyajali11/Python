   "source": [
    "# common between 2 list"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "299e2853",
   "metadata": {},
   "outputs": [],
   "source": [
    "a = [2, 3, 4, 5, 6]\n",
    "b = [5, 6, 7, 8, 9]\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "136c2910",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "List 1: [2, 3, 4, 5, 6]\n",
      "List 2: [5, 6, 7, 8, 9]\n",
      "Common in both list: [5, 6]\n"
     ]
    }
   ],
   "source": [
    "i = 0\n",
    "c = []\n",
    "\n",
    "while i < len(a):\n",
    "    if a[i] in b:\n",
    "        c.append(a[i])\n",
    "    i += 1\n",
    "print('List 1:',a)\n",
    "print('List 2:', b)\n",
    "print('Common in both list:',c)\n"
   ]
  },
