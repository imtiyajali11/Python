      "3628800\n"
     ]
    }
   ],
   "source": [
    "x = 1\n",
    "i = 1\n",
    "\n",
    "while i <= 10:\n",
    "    \n",
    "    x = x * i\n",
    "    i += 1\n",
    "print(x)\n"
   ]
